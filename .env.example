# Copie para .env.local e preencha com os dados do projeto no Supabase (Project Settings > API).
# Sem estas variáveis, o site guarda tudo no navegador, como uma demonstração.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-public
# 1 para mostrar o botão "Continuar com Google" (ative o provedor Google no Supabase antes).
VITE_LOGIN_GOOGLE=0
